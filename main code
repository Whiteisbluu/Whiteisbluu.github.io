<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>White</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      position: relative;
      font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background-color: #000000;
      transition: background-color 0.05s linear;
    }

    .part {
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .glass {
      padding: 1.4rem 3rem;
      border-radius: 100px;
      backdrop-filter: blur(12px) saturate(160%);
      -webkit-backdrop-filter: blur(12px) saturate(160%);
      border: 1px solid rgba(255, 255, 255, 0.25);
      background: rgba(255, 255, 255, 0.08);
      box-shadow:
        inset 0 1px 1px rgba(255, 255, 255, 0.4),
        inset 0 -1px 8px rgba(255, 255, 255, 0.05),
        0 8px 32px rgba(0, 0, 0, 0.25);
    }

    h1 {
      font-size: clamp(2rem, 6vw, 4rem);
      font-weight: 500;
      letter-spacing: 0.05em;
      color: #ffffff;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
    }
  </style>
</head>
<body>

  <div class="part"><div class="glass"><h1>white</h1></div></div>
  <div class="part"><div class="glass"><h1>KARINA</h1></div></div>
  <div class="part"><div class="glass"><h1>WINTER</h1></div></div>
  <div class="part"><div class="glass"><h1>GISELLE</h1></div></div>
  <div class="part"><div class="glass"><h1>NINGNING</h1></div></div>

  <script>
    const body = document.body;
    let ticking = false;

    function update() {
      const maxScroll = document.body.scrollHeight - window.innerHeight;
      const t = maxScroll > 0 ? window.scrollY / maxScroll : 0;

      const wave = t < 0.5 ? t * 2 : (1 - t) * 2;
      const bg = Math.round(wave * 255);

      body.style.backgroundColor = `rgb(${bg}, ${bg}, ${bg})`;

      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    });

    update();
  </script>

</body>
</html>
